import pickle
import numpy as np
import matplotlib.pyplot as plt
from matplotlib.ticker import MaxNLocator

def collinear_lagrange_points(mu):
    """x-positions of L1, L2, L3 (rotating frame, barycentric) by bisection."""
    def f(x):
        return (x - (1 - mu) * (x + mu) / abs(x + mu) ** 3
                  - mu * (x - 1 + mu) / abs(x - 1 + mu) ** 3)

    def bisect(a, b):
        fa = f(a)
        for _ in range(200):
            m = 0.5 * (a + b)
            fm = f(m)
            if fa * fm <= 0:
                b = m
            else:
                a, fa = m, fm
        return 0.5 * (a + b)

    eps = 1e-6
    L1 = bisect(-mu + eps, 1 - mu - eps)
    L2 = bisect(1 - mu + eps, 2.0)
    L3 = bisect(-2.0, -mu - eps)
    return L1, L2, L3


def plot_orbit_family_3d(filename, mu=0.01215058560962404, lstar_km=384400.0,
                         show=True, save_to=None, fit_lagrange=False,
                         include_earth=True):
    """Universal 3D plotter for CR3BP orbit families."""
    try:
        with open(filename, 'rb') as file:
            trajectories = pickle.load(file)
    except FileNotFoundError:
        print(f"Error: {filename} not found. Run generate_family.py first.")
        return
    print(f"Loaded {len(trajectories)} orbits from {filename}.")

    arrs = [np.array(t) for t in trajectories]
    pts = np.vstack([a[:, :3] for a in arrs])
    pts = np.vstack([pts, pts * np.array([1, -1, 1])])
    print(f"Data ranges -> X: [{pts[:,0].min():.3f}, {pts[:,0].max():.3f}] | "
          f"Y: [{pts[:,1].min():.3f}, {pts[:,1].max():.3f}] | "
          f"Z: [{pts[:,2].min():.3f}, {pts[:,2].max():.3f}]")

    # Closest approach to each body over the whole family
    closest = {}
    for name, bx in (("Earth", -mu), ("Moon", 1 - mu)):
        best = None
        for k, a in enumerate(arrs):
            d = np.sqrt((a[:, 0] - bx) ** 2 + a[:, 1] ** 2 + a[:, 2] ** 2)
            j = int(np.argmin(d))
            if best is None or d[j] < best[0]:
                best = (d[j], k, a[j, :3])
                
        closest[name] = best
        best_dist, best_k, p = best
        print(f"Closest to {name}: {best_dist:.5f} LD ({best_dist * lstar_km:,.0f} km) "
              f"at orbit #{best_k} (of {len(arrs)}), position "
              f"[{p[0]:.5f}, {p[1]:.5f}, {p[2]:.5f}]")

    # ---------------------------------------------------------
    # 1. 3D TRAJECTORY PLOT
    # ---------------------------------------------------------
    fig1 = plt.figure(figsize=(10, 8))
    ax = fig1.add_subplot(projection='3d')

    for a in arrs:
        x, y, z = a[:, 0], a[:, 1], a[:, 2]
        ax.plot(x, y, z, color='blue', alpha=0.6, linewidth=0.8)
        ax.plot(x, -y, z, color='blue', alpha=0.6, linewidth=0.8)


    ax.scatter([-mu], [0], [0], color='royalblue', s=120, label='Primary (Earth)', depthshade=False)
    ax.scatter([1 - mu], [0], [0], color='slategray', s=60, label='Secondary (Moon)', depthshade=False)

    lag = collinear_lagrange_points(mu)
    ax.scatter(lag, [0, 0, 0], [0, 0, 0], color='red', s=10, depthshade=False)

    extra = [[x, 0, 0] for x in lag] if fit_lagrange else []
    if include_earth:
        extra.append([-mu, 0, 0])
    lo = np.min([pts.min(axis=0), [1 - mu, 0, 0]] + extra, axis=0)
    hi = np.max([pts.max(axis=0), [1 - mu, 0, 0]] + extra, axis=0)
    span = hi - lo
    span = np.maximum(span, span.max() / 10)
    mid = (hi + lo) / 2
    pad = 1.08
    lo, hi = mid - span * pad / 2, mid + span * pad / 2

    ax.set_xlim(lo[0], hi[0])
    ax.set_ylim(lo[1], hi[1])
    ax.set_zlim(lo[2], hi[2])
    
    for i, lx in enumerate(lag):
        if lo[0] <= lx <= hi[0]:
            ax.text(lx, 0, 0, f"  L{i+1}", color='red', fontsize=10)
            
    ax.set_box_aspect(tuple(hi - lo))
    ax.zaxis.set_major_locator(MaxNLocator(nbins=3))
    ax.set_xlabel("X Position", fontsize=11, labelpad=24)
    ax.set_ylabel("Y Position", fontsize=11, labelpad=14)
    ax.set_zlabel("Z Position", fontsize=11, labelpad=18)
    ax.legend(loc='upper right')

    if save_to:
        fig1.savefig(save_to, dpi=120, bbox_inches='tight')

    if show:
        plt.show()

    return closest

if __name__ == '__main__':
    plot_orbit_family_3d('horseshoe_family.pkl')


    